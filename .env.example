# ClinIQ Monorepo Root Environment Configuration (100% Self-Hosted & Local)

# Local PostgreSQL Database (Docker Port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cliniq

# Ports
API_PORT=4000
WEB_PORT=3000
FHIR_PORT=8103

# Auth Secret
JWT_SECRET=cliniq-dev-jwt-secret-key-replace-in-production-2026

# Self-Hosted FHIR Server (Local)
MEDPLUM_BASE_URL=http://localhost:8103/

# AI Credentials (Optional for local mocks)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
