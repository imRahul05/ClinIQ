# ClinIQ API Server Environment (100% Self-Hosted & Local)
PORT=4000
NODE_ENV=development

# Local PostgreSQL Database (Docker Port 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cliniq

# JWT Authentication Secret
JWT_SECRET=cliniq-dev-jwt-secret-key-replace-in-production-2026

# Web App CORS Origin
CORS_ORIGIN=http://localhost:3000

# Self-Hosted FHIR Server (Local)
MEDPLUM_BASE_URL=http://localhost:8103/

# AI & Speech Services (Optional for Mocking / Live API)
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
